<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Footpath Width Measurer (A4 Calibration)</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --success: #22c55e;
      --warning: #f59e0b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 20px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
    
    header { text-align: center; margin-bottom: 20px; max-width: 800px; }
    h1 { font-size: 1.8rem; margin-bottom: 8px; color: var(--accent); }
    p.desc { color: var(--text-muted); font-size: 0.95rem; }

    .app-container { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 1000px; }
    
    .controls {
      background: var(--card);
      padding: 16px;
      border-radius: 12px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
    }

    .btn {
      background: var(--accent);
      color: #000;
      font-weight: 600;
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn:hover { background: var(--accent-hover); color: #fff; }
    .btn-secondary { background: #334155; color: var(--text); }
    .btn-secondary:hover { background: #475569; }

    .status-badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      background: #334155;
      color: var(--warning);
    }
    .status-badge.calibrated { background: #14532d; color: var(--success); }

    .canvas-wrapper {
      position: relative;
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 400px;
      border: 2px dashed #334155;
    }

    canvas { max-width: 100%; height: auto; cursor: crosshair; display: block; }

    .instruction-box {
      background: var(--card);
      padding: 16px;
      border-radius: 12px;
      border-left: 4px solid var(--accent);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .results-card {
      background: var(--card);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      display: none;
    }
    .results-card h2 { color: var(--text-muted); font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; }
    .results-card .value { font-size: 2.5rem; font-weight: 700; color: var(--accent); margin: 8px 0; }
  </style>
</head>
<body>

  <header>
    <h1>Footpath Width Estimator</h1>
    <p class="desc">Calibrate using an A4 paper sheet ($210\text{ mm} \times 297\text{ mm}$) placed on the ground, then measure any distance in perspective.</p>
  </header>

  <div class="app-container">
    <div class="controls">
      <input type="file" id="imageInput" accept="image/*" style="display: none;" />
      <button class="btn" onclick="document.getElementById('imageInput').click()">📷 Upload Photo</button>
      <button class="btn btn-secondary" id="resetBtn" disabled>Reset Points</button>
      <div class="status-badge" id="statusBadge">Step 1: Upload a photo</div>
    </div>

    <div class="instruction-box" id="instructionBox">
      <strong>Instructions:</strong> Upload a photo containing an A4 paper sheet on the ground.
    </div>

    <div class="canvas-wrapper" id="canvasWrapper">
      <canvas id="mainCanvas"></canvas>
    </div>

    <div class="results-card" id="resultsCard">
      <h2>Measured Width</h2>
      <div class="value" id="measurementResult">0.00 m</div>
      <p style="color: var(--text-muted); font-size: 0.85rem;" id="subUnits">0 cm / 0 inches</p>
    </div>
  </div>

  <script>
    // --- State Variables ---
    const canvas = document.getElementById('mainCanvas');
    const ctx = canvas.getContext('2d');
    const imageInput = document.getElementById('imageInput');
    const resetBtn = document.getElementById('resetBtn');
    const statusBadge = document.getElementById('statusBadge');
    const instructionBox = document.getElementById('instructionBox');
    const resultsCard = document.getElementById('resultsCard');

    let img = new Image();
    let points = []; // Holds clicked points
    let state = 'UPLOAD'; // UPLOAD -> CALIBRATING -> MEASURING
    let H = null; // 3x3 Homography Matrix

    // Standard ISO A4 dimensions in meters
    const A4_WIDTH = 0.210;
    const A4_HEIGHT = 0.297;

    // --- Image Upload Handler ---
    imageInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        img = new Image();
        img.onload = () => {
          canvas.width = img.width;
          canvas.height = img.height;
          resetApp();
          state = 'CALIBRATING';
          updateUI();
          render();
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });

    // --- Canvas Click Handler ---
    canvas.addEventListener('click', (e) => {
      if (!img.src) return;

      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      const x = (e.clientX - rect.left) * scaleX;
      const y = (e.clientY - rect.top) * scaleY;

      if (state === 'CALIBRATING') {
        if (points.length < 4) {
          points.push({ x, y });
          if (points.length === 4) {
            computeHomographyMatrix();
            state = 'MEASURING';
            points = []; // Clear points for measuring phase
          }
        }
      } else if (state === 'MEASURING') {
        points.push({ x, y });
        if (points.length === 2) {
          calculateDistance();
        } else if (points.length > 2) {
          points = [{ x, y }]; // Reset to starting point for a new line
          resultsCard.style.display = 'none';
        }
      }

      updateUI();
      render();
    });

    resetBtn.addEventListener('click', () => {
      if (!img.src) return;
      resetApp();
      state = 'CALIBRATING';
      updateUI();
      render();
    });

    function resetApp() {
      points = [];
      H = null;
      resultsCard.style.display = 'none';
      resetBtn.disabled = false;
    }

    // --- Linear Algebra: Solve Homography (DLT Algorithm) ---
    function computeHomographyMatrix() {
      // Source points (clicked pixel points on A4 paper corners)
      // Expect order: Top-Left, Top-Right, Bottom-Right, Bottom-Left
      const src = points;

      // Destination real-world coordinates in meters (0,0 is top-left of paper)
      const dst = [
        { x: 0, y: 0 },
        { x: A4_WIDTH, y: 0 },
        { x: A4_WIDTH, y: A4_HEIGHT },
        { x: 0, y: A4_HEIGHT }
      ];

      // Build system of 8 linear equations Ah = 0
      let A = [];
      for (let i = 0; i < 4; i++) {
        let x = src[i].x, y = src[i].y;
        let u = dst[i].x, v = dst[i].y;
        A.push([-x, -y, -1, 0, 0, 0, x * u, y * u, u]);
        A.push([0, 0, 0, -x, -y, -1, x * v, y * v, v]);
      }

      // Solve SVD/Gaussian Elimination for A to find 3x3 matrix H
      H = solveHomographyDLT(A);
    }

    function solveHomographyDLT(A) {
      // Basic Gaussian elimination solver for Ah = 0 (assuming h[8] = 1)
      let M = A.map(row => [...row]);
      for (let i = 0; i < 8; i++) {
        let maxRow = i;
        for (let k = i + 1; k < 8; k++) {
          if (Math.abs(M[k][i]) > Math.abs(M[maxRow][i])) maxRow = k;
        }
        [M[i], M[maxRow]] = [M[maxRow], M[i]];

        let pivot = M[i][i];
        for (let j = i; j < 9; j++) M[i][j] /= pivot;

        for (let k = 0; k < 8; k++) {
          if (k !== i) {
            let factor = M[k][i];
            for (let j = i; j < 9; j++) M[k][j] -= factor * M[i][j];
          }
        }
      }
      let h = [];
      for (let i = 0; i < 8; i++) h.push(-M[i][8]);
      h.push(1.0); // Normalize scale factor
      return h;
    }

    // --- Transform Pixel Point to Real-World Ground Plane (Meters) ---
    function transformPoint(pt) {
      let x = pt.x, y = pt.y;
      let px = H[0]*x + H[1]*y + H[2];
      let py = H[3]*x + H[4]*y + H[5];
      let pz = H[6]*x + H[7]*y + H[8];

      return { x: px / pz, y: py / pz };
    }

    // --- Calculate Distance Between 2 Measured Points ---
    function calculateDistance() {
      const p1_real = transformPoint(points[0]);
      const p2_real = transformPoint(points[1]);

      const dx = p2_real.x - p1_real.x;
      const dy = p2_real.y - p1_real.y;
      const distanceMeters = Math.sqrt(dx * dx + dy * dy);

      document.getElementById('measurementResult').innerText = `${distanceMeters.toFixed(2)} m`;
      document.getElementById('subUnits').innerText = `${(distanceMeters * 100).toFixed(1)} cm / ${(distanceMeters * 39.3701).toFixed(1)} inches`;
      resultsCard.style.display = 'block';
    }

    // --- Rendering Pipeline ---
    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0);

      // Render calibration overlay
      if (state === 'CALIBRATING') {
        ctx.fillStyle = '#38bdf8';
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = Math.max(2, canvas.width / 400);

        points.forEach((pt, idx) => {
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, Math.max(6, canvas.width / 150), 0, Math.PI * 2);
          ctx.fill();

          ctx.font = `${Math.max(14, canvas.width / 50)}px sans-serif`;
          ctx.fillText(` ${idx + 1}`, pt.x + 10, pt.y - 10);
        });

        if (points.length > 1) {
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
          if (points.length === 4) ctx.closePath();
          ctx.stroke();
        }
      }

      // Render measurement line
      if (state === 'MEASURING') {
        ctx.fillStyle = '#22c55e';
        ctx.strokeStyle = '#22c55e';
        ctx.lineWidth = Math.max(3, canvas.width / 300);

        points.forEach((pt) => {
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, Math.max(6, canvas.width / 150), 0, Math.PI * 2);
          ctx.fill();
        });

        if (points.length === 2) {
          ctx.beginPath();
          ctx.moveTo(points[0].x, points[0].y);
          ctx.lineTo(points[1].x, points[1].y);
          ctx.stroke();
        }
      }
    }

    // --- UI Helper Text ---
    function updateUI() {
      if (state === 'CALIBRATING') {
        const remaining = 4 - points.length;
        statusBadge.className = 'status-badge';
        if (remaining > 0) {
          statusBadge.innerText = `Click corner ${points.length + 1} of 4`;
          instructionBox.innerHTML = `<strong>Calibration Step:</strong> Click the 4 corners of the A4 paper in order: <br>1. Top-Left &rarr; 2. Top-Right &rarr; 3. Bottom-Right &rarr; 4. Bottom-Left`;
        }
      } else if (state === 'MEASURING') {
        statusBadge.className = 'status-badge calibrated';
        statusBadge.innerText = 'Calibrated ✓';
        if (points.length === 0) {
          instructionBox.innerHTML = `<strong>Measurement Step:</strong> Click the <strong>first edge</strong> of the footpath.`;
        } else if (points.length === 1) {
          instructionBox.innerHTML = `<strong>Measurement Step:</strong> Click the <strong>opposite edge</strong> of the footpath to complete the line.`;
        } else {
          instructionBox.innerHTML = `<strong>Done!</strong> Click anywhere on the image to draw a new measurement line.`;
        }
      }
    }
  </script>
</body>
</html>
